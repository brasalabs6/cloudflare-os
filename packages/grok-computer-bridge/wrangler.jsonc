{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grok-computer-bridge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-02-02",
  "compatibility_flags": ["nodejs_compat"],

  // Container: builds the Dockerfile that installs grok + bridge.
  // The container runs inside the Cloudflare Computer and has network
  // access (for grok to reach the xAI API).
  // class_name is required by Wrangler and must match the DO class that
  // owns the container lifecycle.
  "containers": [
    {
      "name": "grok-container",
      "class_name": "GrokComputer",
      "image": "./Dockerfile"
    }
  ],

  // Durable Object: one per workspace. Manages the container + run state.
  "durable_objects": {
    "bindings": [
      {
        "name": "GROK_COMPUTER",
        "class_name": "GrokComputer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GrokComputer"]
    }
  ],

  // Variables (non-secret). XAI_API_KEY is set via `wrangler secret put`.
  "vars": {
    "GROK_BRIDGE_API_KEY": "",
    "GROK_MODEL": "grok-build"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
